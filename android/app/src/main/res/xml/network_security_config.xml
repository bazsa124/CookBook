<?xml version="1.0" encoding="utf-8"?>
<!--
    The server speaks plain HTTP; confidentiality comes from Tailscale's
    WireGuard tunnel (same model as Remoter). Point this app only at a tailnet
    address or MagicDNS name.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
